# Server port (defaults to 3000 in AI Studio)
PORT=3000

# Riot Games API Key for League of Legends match and summoner data
RIOT_API_KEY=

# Gemini API Key for AI features (accessible server-side)
GEMINI_API_KEY=

# Database Connection URL (PostgreSQL / Cloud SQL)
DATABASE_URL=

# Session Secret for user authentication tokens
SESSION_SECRET=

# NVIDIA / LLM API configuration (optional fallback)
NVIDIA_API_KEY=
NVIDIA_AI_MODEL=
NVIDIA_AI_FALLBACK_MODEL=
